# Copy to .env locally. Never commit the real .env file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Keep 1 for a first dry run; set 0 only after verifying the chat and symbols.
DRY_RUN=1

# Earliest time to emit C candidates (Asia/Kolkata). Default is 15:15.
# Earlier values increase the chance that the candle later changes shape.
C_SIGNAL_START=15:15

# After the 15:30 IST close, today's candle is settled and is re-checked until
# this time so a missed late-session poll cannot silently lose the session.
# Use 0/off/none/disabled to turn the settled-candle pass off.
C_POST_CLOSE_UNTIL=17:00

# Ignore yfinance intraday snapshots older than this (seconds).
# Yahoo's NSE intraday feed is normally delayed by ~15 minutes, so a small value
# (e.g. 300) rejects every quote inside the 15:15-15:30 IST window and the scan
# cannot evaluate a candidate at all. Delayed quotes are used with a warning and
# the alert states their timestamp; quotes older than 3600s, or from a previous
# session, are always skipped.
MAX_QUOTE_AGE_SECONDS=1200

# Optional position-size estimate in each C trade plan. Leave blank if unset.
ACCOUNT_CAPITAL_INR=
RISK_PER_TRADE_PCT=1.0
